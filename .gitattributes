# Make GitHub recognise SQL files properly
*.sql linguist-detectable=true
*.sql linguist-language=sql

# Make GitHub recognise YAML files (important for dbt projects)
*.yml linguist-detectable=true
*.yaml linguist-detectable=true

# Shell scripts must stay LF so they run on macOS/Linux/Codespaces
*.sh text eol=lf

# Fusion version pin is read by bash (CI/devcontainer); keep LF so reads don't pick up a trailing CR
.fusion-version text eol=lf