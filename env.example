# Snowflake Connection Configuration
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!

# Snowflake Account (e.g., your-org.eu-west-1 or xy12345)
SNOWFLAKE_ACCOUNT=your-account-here

# Snowflake Username
SNOWFLAKE_USER=your-username-here

# Snowflake Role (ANALYST role for generic analytics)
SNOWFLAKE_ROLE=ANALYST

# Snowflake Warehouse (e.g., NCL_ANALYTICS_XS)
SNOWFLAKE_WAREHOUSE=your-warehouse-here

# Optional: Snowflake Programmatic Access Token (recommended for Codespaces / headless local).
# When set, Fusion authenticates with it via programmatic_access_token (the `token` field).
# (CI uses key-pair auth, not a PAT - see the ci-dev/ci-prod targets in profiles.yml.)
# SNOWFLAKE_PAT=your-programmatic-access-token

# Optional: Override authenticator. Default: programmatic_access_token if SNOWFLAKE_PAT is set,
# else username_password_mfa if SNOWFLAKE_PASSWORD is set, else externalbrowser.
# SNOWFLAKE_AUTHENTICATOR=
